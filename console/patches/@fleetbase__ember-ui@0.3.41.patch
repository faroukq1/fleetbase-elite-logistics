diff --git a/addon/helpers/localize-label.js b/addon/helpers/localize-label.js
new file mode 100644
index 0000000000000000000000000000000000000000..4168fadee8b47819fc42fa5afbe310298ed55527
--- /dev/null
+++ b/addon/helpers/localize-label.js
@@ -0,0 +1,26 @@
+import Helper from '@ember/component/helper';
+import { inject as service } from '@ember/service';
+
+/**
+ * {{localize-label someText "prefix"}}
+ *
+ * Slugifies the English label and looks up `prefix.<slug>` in the active
+ * locale, falling back to the original text when no translation exists.
+ * Lets us localize dynamically-registered nav/launcher labels without
+ * touching every engine's extension.js.
+ */
+export default class LocalizeLabelHelper extends Helper {
+    @service intl;
+
+    compute([text, prefix]) {
+        if (!text || typeof text !== 'string') {
+            return text;
+        }
+        const slug = text
+            .toLowerCase()
+            .replace(/[^a-z0-9]+/g, '-')
+            .replace(/^-|-$/g, '');
+        const key = `${prefix}.${slug}`;
+        return this.intl.exists(key) ? this.intl.t(key) : text;
+    }
+}
