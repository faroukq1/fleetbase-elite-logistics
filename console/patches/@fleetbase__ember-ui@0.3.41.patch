diff --git a/addon/utils/calculate-tray-position.js b/addon/utils/calculate-tray-position.js
new file mode 100644
index 0000000000000000000000000000000000000000..60cc274b106118408689a599635efa36a90ac2ca
--- /dev/null
+++ b/addon/utils/calculate-tray-position.js
@@ -0,0 +1,41 @@
+/**
+ * Position a header tray dropdown (org/user menu, language selector,
+ * notifications) below its trigger, aligned to the trigger's inline-end edge,
+ * and clamped to the viewport.
+ *
+ * Used instead of ember-basic-dropdown's default calculate-position: its
+ * horizontal math assumes LTR document flow, so in RTL the content drifts away
+ * from the trigger or off-screen entirely. The dropdown renders through the
+ * wormhole (not in place), which also keeps it clear of page-level
+ * overflow/stacking contexts like the Fleet-Ops map layout.
+ *
+ * Coordinates are viewport-space with `position: fixed` (the header never
+ * scrolls): page-space `absolute` coordinates break as soon as the document
+ * has horizontal overflow — common in RTL — because the wormhole's containing
+ * block and the scroll offsets stop agreeing with what the user sees.
+ *
+ * @param {HTMLElement} trigger
+ * @param {HTMLElement} content
+ * @return {Object} position result consumed by ember-basic-dropdown
+ */
+export default function calculateTrayPosition(trigger, content) {
+    const rect = trigger.getBoundingClientRect();
+    const contentWidth = content.offsetWidth || 260;
+    const isRtl = (document.documentElement.getAttribute('dir') || 'ltr') === 'rtl';
+    const margin = 8;
+
+    // LTR: align the menu's right edge with the trigger's right edge.
+    // RTL (mirrored layout, trigger near the screen's left): align left edges.
+    let left = isRtl ? rect.left : rect.right - contentWidth;
+    left = Math.max(margin, Math.min(left, window.innerWidth - contentWidth - margin));
+
+    return {
+        horizontalPosition: isRtl ? 'left' : 'right',
+        verticalPosition: 'below',
+        style: {
+            position: 'fixed',
+            left: Math.round(left),
+            top: Math.round(rect.bottom + 6),
+        },
+    };
+}
