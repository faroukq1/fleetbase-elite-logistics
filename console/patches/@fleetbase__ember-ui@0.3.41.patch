diff --git a/addon/helpers/localize-label.js b/addon/helpers/localize-label.js
new file mode 100644
index 0000000000000000000000000000000000000000..5a628d072b9ddb230eef130af04e948615972698
--- /dev/null
+++ b/addon/helpers/localize-label.js
@@ -0,0 +1,31 @@
+import Helper from '@ember/component/helper';
+import { inject as service } from '@ember/service';
+
+/**
+ * {{localize-label someText "prefix" "fallbackPrefix" ...}}
+ *
+ * Slugifies the English label and looks up `<prefix>.<slug>` under each given
+ * prefix in order, falling back to the original text when no translation
+ * exists. Lets us localize dynamically-registered nav/launcher labels without
+ * touching every engine's extension.js.
+ */
+export default class LocalizeLabelHelper extends Helper {
+    @service intl;
+
+    compute([text, ...prefixes]) {
+        if (!text || typeof text !== 'string') {
+            return text;
+        }
+        const slug = text
+            .toLowerCase()
+            .replace(/[^a-z0-9]+/g, '-')
+            .replace(/^-|-$/g, '');
+        for (const prefix of prefixes) {
+            const key = `${prefix}.${slug}`;
+            if (this.intl.exists(key)) {
+                return this.intl.t(key);
+            }
+        }
+        return text;
+    }
+}
