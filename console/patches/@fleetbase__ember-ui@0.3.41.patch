+    get displayTitle() {
+        const title = this.args.item?.title;
+        if (!title || typeof title !== 'string') {
+            return title;
+        }
+        const slug = title
+            .toLowerCase()
+            .replace(/[^a-z0-9]+/g, '-')
+            .replace(/^-|-$/g, '');
+        for (const prefix of ['header-nav', 'nav-card-title']) {
+            const key = `${prefix}.${slug}`;
+            if (this.intl.exists(key)) {
+                return this.intl.t(key);
+            }
+        }
+        return title;
+    }
 
