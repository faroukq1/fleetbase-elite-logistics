diff --git a/addon/helpers/localize-label.js b/addon/helpers/localize-label.js
new file mode 100644
index 0000000..5a628d0
--- /dev/null
+++ b/addon/helpers/localize-label.js
@@ -0,0 +1,31 @@
+import Helper from '@ember/component/helper';
+import { inject as service } from '@ember/service';
+
+/**
+ * {{localize-label someText "prefix" "fallbackPrefix" ...}}
+ *
+ * Slugifies the English label and looks up `<prefix>.<slug>` under each given
+ * prefix in order, falling back to the original text when no translation
+ * exists. Lets us localize dynamically-registered nav/launcher labels without
+ * touching every engine's extension.js.
+ */
+export default class LocalizeLabelHelper extends Helper {
+    @service intl;
+
+    compute([text, ...prefixes]) {
+        if (!text || typeof text !== 'string') {
+            return text;
+        }
+        const slug = text
+            .toLowerCase()
+            .replace(/[^a-z0-9]+/g, '-')
+            .replace(/^-|-$/g, '');
+        for (const prefix of prefixes) {
+            const key = `${prefix}.${slug}`;
+            if (this.intl.exists(key)) {
+                return this.intl.t(key);
+            }
+        }
+        return text;
+    }
+}
diff --git a/addon/helpers/translate-value.js b/addon/helpers/translate-value.js
new file mode 100644
index 0000000..b64d964
--- /dev/null
+++ b/addon/helpers/translate-value.js
@@ -0,0 +1,37 @@
+import Helper from '@ember/component/helper';
+import { inject as service } from '@ember/service';
+
+/**
+ * {{translate-value value "prefix" keySource}}
+ *
+ * Translates an API-provided value using `<prefix>.<keySource|value>` when the
+ * key exists (tried verbatim first, then slugified), falling back to the raw
+ * value. Used by table cells via `column.translationPrefix` /
+ * `column.translationKeyPath` to localize backend enum/seed values.
+ */
+export default class TranslateValueHelper extends Helper {
+    @service intl;
+
+    compute([value, prefix, keySource]) {
+        if (!prefix || value === null || value === undefined || value === '') {
+            return value;
+        }
+
+        const source = `${keySource ?? value}`;
+        const exactKey = `${prefix}.${source}`;
+        if (this.intl.exists(exactKey)) {
+            return this.intl.t(exactKey);
+        }
+
+        const slug = source
+            .toLowerCase()
+            .replace(/[^a-z0-9]+/g, '-')
+            .replace(/^-|-$/g, '');
+        const slugKey = `${prefix}.${slug}`;
+        if (slug && this.intl.exists(slugKey)) {
+            return this.intl.t(slugKey);
+        }
+
+        return value;
+    }
+}
