<div class="elite-login">
    <LinkTo @route="console" class="elite-login-logo">
        <LogoIcon @size="16" class="rounded-md" />
    </LinkTo>
    <h1 class="elite-login-title">
        {{if this.isSent (t "auth.forgot-password.is-sent.title") (t "auth.forgot-password.not-sent.title")}}
    </h1>

    {{#if this.isSent}}
        <p class="elite-login-subtitle">{{t "auth.forgot-password.is-sent.message" htmlSafe=true}}</p>
        <Button
            @icon="check"
            @type="primary"
            @text={{t "common.continue"}}
            @wrapperClass="btn-block elite-signin"
            @onClick={{transition-to "auth.login"}}
        />
    {{else}}
        <p class="elite-login-subtitle">{{t "auth.forgot-password.not-sent.message" htmlSafe=true appName=(t "app.name")}}</p>

        <form class="elite-login-form" {{on "submit" (perform this.sendSecureLink)}}>
            <div class="elite-field">
                <label for="email">{{t "auth.forgot-password.form.email-label"}}</label>
                <Input
                    @value={{this.email}}
                    @type="email"
                    id="email"
                    name="email"
                    required
                    placeholder={{t "auth.forgot-password.form.email-label"}}
                />
            </div>

            <Button
                @icon="magic"
                @type="primary"
                @buttonType="submit"
                @text={{t "auth.forgot-password.form.submit-button"}}
                @wrapperClass="btn-block elite-signin"
                @onClick={{perform this.sendSecureLink}}
                @isLoading={{this.sendSecureLink.isRunning}}
            />

            <p class="elite-login-footer">
                <LinkTo @route="auth.login" class="elite-contact">{{t "auth.forgot-password.form.nevermind-button"}}</LinkTo>
            </p>
        </form>
    {{/if}}
</div>
