<div class="elite-login">
    <LinkTo @route="console" class="elite-login-logo">
        <LogoIcon @brand={{@brand}} @size="16" class="rounded-md" />
    </LinkTo>
    <h1 class="elite-login-title">{{t "auth.login.log-in"}}</h1>
    <p class="elite-login-subtitle">{{t "auth.login.welcome-back"}}</p>

    {{#if (gte this.failedAttempts 3)}}
        <div class="elite-login-alert">
            <FaIcon @icon="triangle-exclamation" class="mr-2" />
            <p>{{t "auth.login.failed-attempt.message" htmlSafe=true}}</p>
        </div>
    {{/if}}

    <form class="elite-login-form" {{on "submit" this.login}}>
        <input type="hidden" name="remember" value="true" />

        <div class="elite-field">
            <label for="email">{{t "auth.login.form.email-label"}}</label>
            <Input
                @value={{this.identity}}
                aria-label={{t "auth.login.form.email-label"}}
                name="email"
                @type="email"
                autocomplete="username"
                required
                placeholder={{t "auth.login.form.email-label"}}
                disabled={{this.isLoading}}
            />
        </div>

        <div class="elite-field">
            <label for="password">{{t "auth.login.form.password-label"}}</label>
            <Input
                @value={{this.password}}
                aria-label={{t "auth.login.form.password-label"}}
                name="password"
                @type="password"
                autocomplete="current-password"
                required
                placeholder={{t "auth.login.form.password-label"}}
                disabled={{this.isLoading}}
            />
        </div>

        <div class="elite-login-row">
            <label class="elite-remember">
                <Input id="rememberMe" @type="checkbox" @checked={{this.rememberMe}} disabled={{this.isLoading}} />
                <span>{{t "auth.login.remember-30-days"}}</span>
            </label>
            <a href="javascript:;" {{on "click" this.forgotPassword}} disabled={{this.isLoading}} class="elite-forgot">
                {{t "auth.login.form.forgot-password-label"}}
            </a>
        </div>

        <Button
            @buttonType="submit"
            @type="primary"
            @text={{t "auth.login.form.sign-in-button"}}
            @wrapperClass="btn-block elite-signin"
            @isLoading={{this.isLoading}}
            @onClick={{this.login}}
        />

        <p class="elite-login-footer">
            {{t "auth.login.no-account"}}
            <LinkTo @route="onboard" class="elite-contact">{{t "auth.login.contact-admin"}}</LinkTo>
        </p>
    </form>
</div>
