<div class="elite-auth onboard-route-wrapper">
    <div class="elite-auth-brand">
        <div class="elite-auth-brand-inner">
            <LogoIcon @brand={{@model}} @size="28" class="elite-auth-brand-logo" />
            <div class="elite-auth-brand-tagline">{{t "auth.login.logistics-tagline"}}</div>
        </div>
    </div>
    <div class="elite-auth-main">
        <div class="elite-auth-card elite-auth-card--wide">
            {{outlet}}
        </div>
    </div>
</div>
